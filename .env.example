# ---------------------------------------------------------------------------
# Agent V — production configuration
# Copy to .env and fill. Every secret stays server-side; nothing is echoed in chat.
# ---------------------------------------------------------------------------

# --- identity ---------------------------------------------------------------
APP_NAME=AgentV
LOG_LEVEL=INFO
# Comma separated numeric Telegram user IDs. These get owner role (full tools).
OWNER_IDS=

# --- normal bot (BotFather token) -------------------------------------------
BOT_API_ENABLED=true
BOT_TOKEN=
# Optional: set a public https URL to run webhook instead of long polling
BOT_WEBHOOK_URL=
# Shared secret for the webhook path (auto-generated when empty)
BOT_WEBHOOK_SECRET=

# --- userbot (MTProto, acts as your account) --------------------------------
USERBOT_ENABLED=false
TG_API_ID=
TG_API_HASH=
# StringSession value (recommended) or a path to a .session file
USERBOT_SESSION=
USERBOT_PREFIX=.
# Comma separated ids allowed to talk to the userbot in private (owner always allowed)
USERBOT_ALLOWED_USERS=

# --- storage / crypto -------------------------------------------------------
DATABASE_PATH=data/agentv.db
DATA_DIR=data
# Generate: openssl rand -hex 32   (auto-created in data/agentv.secret if empty)
SECRET_KEY=

# --- default LLM provider (OpenAI compatible) -------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=minimax-m3
LLM_VISION_MODEL=
LLM_TIMEOUT=120
THINKING_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
MAX_TOOL_STEPS=8
MAX_HISTORY=20
# per-user, per-chat message limit; 0 = disabled, owner is exempt
RATE_LIMIT_PER_MIN=0
# react to messages automatically based on mood (true/false)
AUTO_REACT=true
# instant | low | medium | high | max  (instant = no reasoning)
REASONING_DEFAULT=high
# Tool-log message self-destructs after N seconds (0 = keep)
TOOL_LOG_TTL=10

# --- sandboxed code execution ----------------------------------------------
SANDBOX_ENABLED=true
SANDBOX_IMAGE=agentv-runner:latest
# Allow outbound network from the sandbox for owner commands
SANDBOX_NETWORK=true
SANDBOX_MEMORY=3g
SANDBOX_STORAGE=4g
SANDBOX_CPUS=2.0
SANDBOX_PIDS=256
SANDBOX_TIMEOUT=25
# hard cap for each tool execution
TOOL_TIMEOUT_SECONDS=25
SANDBOX_MAX_CONCURRENT=4
SANDBOX_VOLUME=agentv-workspace
WORKSPACE_DIR=/workspace
# media limits in MB (user uploads to bot vs files the bot sends)
MAX_UPLOAD_MB=10
MAX_DOWNLOAD_MB=50
# Let non-owner users run shell at all (still filtered + offline container)
ALLOW_USER_SHELL=true

# --- tools ------------------------------------------------------------------
BRAVE_API_KEY=
PLUGINS_DIR=plugins
STREAM_EDIT_INTERVAL=0.7

# --- rendering (Bot API 10.x) ----------------------------------------------
# auto = use rich messages / draft streaming when the API accepts them
RICH_MESSAGES=auto
DRAFT_STREAMING=off
SHOW_THINKING=true

# --- web (health + optional webhook) ---------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8080
